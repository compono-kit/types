{
	"name": "compono-kit/types",
	"description": "Basic type classes wrapping scalar values to create types in applications. Implementations of compono-kit/types-interfaces",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"license": "proprietary",
	"authors": [
		{
			"name": "Benjamin Bruska",
			"email": "benjamin.bruska@your-coder.de"
		}
	],
	"require": {
		"php": ">=8.0",
        "ext-intl": "*",
		"ext-json": "*",
		"ext-ctype": "*",
		"compono-kit/types-interfaces": "^1.0.0"
    },
	"require-dev": {
		"phpunit/phpunit": "^9.0.0"
	},
	"autoload": {
		"psr-4": {
			"ComponoKit\\Types\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"ComponoKit\\Types\\Tests\\": "tests/"
		}
	}
}
